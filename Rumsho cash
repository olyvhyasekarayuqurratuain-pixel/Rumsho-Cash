name: Build APK Rumsho Cash

on:
  workflow_dispatch:
  push:
    branches: [main, master]

permissions:
  contents: write

jobs:
  build-apk:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Pasang Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Pasang Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Buat folder android/
        run: flutter create . --platforms=android --org id.rumsho --project-name rumsho_cash

      - name: Pasang AndroidManifest (izin Bluetooth & kamera)
        run: |
          cp android_setup/AndroidManifest.xml android/app/src/main/AndroidManifest.xml
          rm -f test/widget_test.dart

      - name: Unduh paket
        run: flutter pub get

      - name: Build APK release
        run: flutter build apk --release --split-per-abi

      - name: Ganti nama APK
        run: |
          cd build/app/outputs/flutter-apk
          for f in app-*-release.apk; do
            [ -e "$f" ] && mv "$f" "RumshoCash-${f#app-}"
          done
          ls -la

      - name: Unggah APK (artifact)
        uses: actions/upload-artifact@v4
        with:
          name: RumshoCash-APK
          path: build/app/outputs/flutter-apk/RumshoCash-*.apk

      - name: Terbitkan sebagai Release (link unduh langsung)
        uses: softprops/action-gh-release@v2
        with:
          tag_name: build-${{ github.run_number }}
          name: Rumsho Cash build ${{ github.run_number }}
          body: |
            APK siap install. Untuk hampir semua HP Android modern pilih **RumshoCash-arm64-v8a-release.apk**.
            HP lama (32-bit) pilih **RumshoCash-armeabi-v7a-release.apk**.
          files: build/app/outputs/flutter-apk/RumshoCash-*.apk
